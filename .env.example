# Copiază acest fișier ca „.env” și completează valorile reale.
# Fișierul .env NU trebuie urcat niciodată în control de versiuni sau expus public.

APP_ENV=production
APP_DEBUG=false
# Ex: https://domeniultau.ro/registru  (fără slash la final)
APP_URL=https://domeniultau.ro/registru
APP_TIMEZONE=Europe/Bucharest

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpanelusername_registru
DB_USER=cpanelusername_registru
DB_PASS=schimba-aceasta-parola

# Cheie folosită pentru semnarea sesiunilor/CSRF. Generează un șir aleator lung.
APP_KEY=schimba-acest-sir-aleator-lung-si-secret
